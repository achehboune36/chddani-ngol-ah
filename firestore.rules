rules_version = '2';

// Chddani Ngol Ah — who can do what.
//
// Anyone can sign in with Google. Each person has a member doc with a `status`:
//   approved → in the crew: reads everything, writes their own stuff
//   pending  → waiting for the admin; can only see their own member doc
//   denied   → same as pending, but with a sad face
// New accounts are created `approved` while the site is in OPEN mode, and
// `pending` while it's in APPROVAL mode (config/settings.mode, admin-only switch).
// The admin is identified by email. The placeholder in admin() is filled in from ADMIN_EMAIL in .env.local
// by scripts/render-rules.mjs at deploy time (output: firestore.rules.rendered, gitignored).
//
// Within the crew: each person writes only their own profile and runs.
// Hangouts: the organiser edits details; everyone else only their own RSVP / free slots. Races:
// anyone can add one; only whoever added it can edit or delete it. Two shared
// maps are the exceptions — anyone may set/clear *their own* key in a run's
// `reactions` and a race's `crew` (interested / paid).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function admin() {
      return signedIn() && request.auth.token.email.lower() == '__ADMIN_EMAIL__';
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function crew() {
      return signedIn() && (admin()
        || (exists(memberPath(request.auth.uid))
            && get(memberPath(request.auth.uid)).data.get('status', 'pending') == 'approved'));
    }

    function openMode() {
      let settings = /databases/$(database)/documents/config/settings;
      return !exists(settings) || get(settings).data.mode == 'open';
    }

    function validMember(d) {
      return d.keys().hasOnly(['name', 'photoURL', 'level', 'goalSec', 'joinedAt', 'targetRaceId', 'targetSince', 'planOn', 'status'])
        && d.keys().hasAll(['name', 'photoURL', 'level', 'goalSec', 'joinedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 500))
        && d.level in ['finish', 'sub2', 'sub145']
        && (d.goalSec == null || (d.goalSec is number && d.goalSec >= 600 && d.goalSec <= 36000))
        && d.joinedAt is number
        && (!('targetRaceId' in d) || d.targetRaceId == null || (d.targetRaceId is string && d.targetRaceId.size() <= 100))
        && (!('targetSince' in d) || d.targetSince == null
            || (d.targetSince is string && d.targetSince.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('planOn' in d) || d.planOn is bool)
        && (!('status' in d) || d.status in ['approved', 'pending', 'denied']);
    }

    function validRun(d) {
      return d.keys().hasOnly(['uid', 'date', 'distanceKm', 'durationSec', 'type', 'effort',
                               'feel', 'notes', 'link', 'createdAt', 'reactions'])
        && d.keys().hasAll(['uid', 'date', 'distanceKm', 'durationSec', 'type', 'effort',
                            'feel', 'notes', 'link', 'createdAt', 'reactions'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.distanceKm is number && d.distanceKm > 0 && d.distanceKm <= 100
        && d.durationSec is number && d.durationSec > 0 && d.durationSec < 86400
        && d.type in ['easy', 'long', 'tempo', 'intervals', 'race', 'other']
        && d.effort is int && d.effort >= 1 && d.effort <= 10
        && d.feel in ['great', 'good', 'ok', 'rough']
        && d.notes is string && d.notes.size() <= 1000
        && d.link is string && d.link.size() <= 300
        && d.createdAt is number
        && d.reactions is map;
    }

    // A reaction toggle: only the `reactions` map changes, and inside it only
    // the caller's own key.
    function onlyMyReaction() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['reactions'])
        && after.reactions.diff(before.reactions).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after.reactions)
            || (after.reactions[request.auth.uid] is string
                && after.reactions[request.auth.uid].size() <= 16));
    }

    match /members/{uid} {
      // Your own doc is always readable (that's how a pending person sees they're pending).
      allow read: if (signedIn() && request.auth.uid == uid) || crew();

      // Signing up: approved straight away only in open mode (or for the admin).
      allow create: if signedIn() && request.auth.uid == uid
                    && validMember(request.resource.data)
                    && (request.resource.data.status == 'pending'
                        || (request.resource.data.status == 'approved' && (openMode() || admin())));

      allow update: if
        // editing your own profile — your status is not yours to change
        (signedIn() && request.auth.uid == uid
          && validMember(request.resource.data)
          && request.resource.data.get('status', null) == resource.data.get('status', null))
        // the admin approving / denying someone (status only)
        || (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved', 'pending', 'denied']);

      allow delete: if false;
    }

    // Private sign-up info (email), so the admin knows who's knocking.
    // Readable by its owner and the admin only — never by the rest of the crew.
    match /accounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || admin();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'createdAt', 'lastSeenAt'])
                            && request.resource.data.email == request.auth.token.email
                            && request.resource.data.name is string && request.resource.data.name.size() <= 100
                            && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
                            && request.resource.data.createdAt is number
                            && request.resource.data.lastSeenAt is number;
      allow delete: if false;
    }

    match /config/settings {
      allow read: if crew();
      allow write: if admin()
                   && request.resource.data.keys().hasOnly(['mode'])
                   && request.resource.data.mode in ['open', 'approval'];
    }

    // Empty marker doc: the client tries to read it, and only the admin can.
    match /config/admin {
      allow read: if admin();
      allow write: if false;
    }

    match /runs/{runId} {
      allow read: if crew();

      allow create: if crew()
                    && request.resource.data.uid == request.auth.uid
                    && validRun(request.resource.data)
                    && request.resource.data.reactions.size() == 0;

      allow update: if crew() && (
                      // the owner editing their run (reactions left untouched)
                      (resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.reactions == resource.data.reactions
                        && validRun(request.resource.data))
                      // anyone toggling their own reaction
                      || onlyMyReaction());

      allow delete: if crew() && resource.data.uid == request.auth.uid;
    }

    function validRace(d) {
      return d.keys().hasOnly(['name', 'distanceKm', 'date', 'startTime', 'place', 'link', 'notes',
                               'createdBy', 'createdAt', 'crew'])
        && d.keys().hasAll(['name', 'distanceKm', 'date', 'startTime', 'place', 'link', 'notes',
                            'createdBy', 'createdAt', 'crew'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.distanceKm is number && d.distanceKm >= 1 && d.distanceKm <= 250
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.startTime is string && (d.startTime == '' || d.startTime.matches('^[0-2][0-9]:[0-5][0-9]$'))
        && d.place is string && d.place.size() >= 1 && d.place.size() <= 120
        && d.link is string && d.link.size() <= 300
        && d.notes is string && d.notes.size() <= 1000
        && d.createdAt is number
        && d.crew is map;
    }

    // Joining/leaving a race: only the `crew` map changes, only the caller's key,
    // and the value is one of the two statuses.
    function onlyMyRaceStatus() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['crew'])
        && after.crew.diff(before.crew).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after.crew) || after.crew[request.auth.uid] in ['interested', 'paid']);
    }

    match /races/{raceId} {
      allow read: if crew();

      allow create: if crew()
                    && request.resource.data.createdBy == request.auth.uid
                    && validRace(request.resource.data)
                    && request.resource.data.crew.keys().hasOnly([request.auth.uid])
                    && request.resource.data.crew.values().hasOnly(['interested', 'paid']);

      allow update: if crew() && (
                      (resource.data.createdBy == request.auth.uid
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.crew == resource.data.crew
                        && validRace(request.resource.data))
                      || onlyMyRaceStatus());

      allow delete: if crew() && resource.data.createdBy == request.auth.uid;
    }

    // ------------------------------------------------------------ hangouts
    function validPoll(p) {
      return p == null || (p is map
        && p.keys().hasOnly(['days', 'fromHour', 'toHour', 'durationMin'])
        && p.keys().hasAll(['days', 'fromHour', 'toHour', 'durationMin'])
        && p.days is list && p.days.size() >= 1 && p.days.size() <= 14
        && p.fromHour is int && p.fromHour >= 0 && p.fromHour <= 23
        && p.toHour is int && p.toHour >= 1 && p.toHour <= 24 && p.fromHour < p.toHour
        && p.durationMin is int && p.durationMin >= 30 && p.durationMin <= 720);
    }

    function validHangout(d) {
      return d.keys().hasOnly(['title', 'kind', 'place', 'notes', 'link', 'date', 'startTime', 'endTime',
                               'poll', 'createdBy', 'createdAt', 'rsvp', 'avail', 'image'])
        && d.keys().hasAll(['title', 'kind', 'place', 'notes', 'link', 'date', 'startTime', 'endTime',
                            'poll', 'createdBy', 'createdAt', 'rsvp', 'avail'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.kind in ['cinema', 'food', 'coffee', 'sport', 'games', 'trip', 'other']
        && d.place is string && d.place.size() <= 120
        && d.notes is string && d.notes.size() <= 1000
        && d.link is string && d.link.size() <= 300
        && (d.date == null || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.startTime is string && (d.startTime == '' || d.startTime.matches('^[0-2][0-9]:[0-5][0-9]$'))
        && d.endTime is string && (d.endTime == '' || d.endTime.matches('^[0-2][0-9]:[0-5][0-9]$'))
        && (d.date != null || d.poll != null)
        && validPoll(d.poll)
        && d.createdAt is number
        && d.rsvp is map && d.avail is map
        // cover photo: a small inline JPEG/PNG/WebP data URL, nothing else (no external URLs)
        && (!('image' in d) || d.image == null
            || (d.image is string && d.image.size() <= 240000
                && d.image.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')));
    }

    // Only `field` changes, and inside it only the caller's own key.
    function onlyMyKeyIn(field) {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly([field])
        && after[field].diff(before[field]).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /hangouts/{hangoutId} {
      allow read: if crew();

      allow create: if crew()
                    && request.resource.data.createdBy == request.auth.uid
                    && validHangout(request.resource.data)
                    && request.resource.data.rsvp.keys().hasOnly([request.auth.uid])
                    && request.resource.data.avail.keys().hasOnly([request.auth.uid]);

      allow update: if crew() && (
                      // the organiser editing details / locking a time (answers untouched)
                      (resource.data.createdBy == request.auth.uid
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.rsvp == resource.data.rsvp
                        && request.resource.data.avail == resource.data.avail
                        && validHangout(request.resource.data))
                      // anyone answering: going / maybe / no
                      || (onlyMyKeyIn('rsvp')
                          && (!(request.auth.uid in request.resource.data.rsvp)
                              || request.resource.data.rsvp[request.auth.uid] in ['going', 'maybe', 'no']))
                      // anyone painting their free slots
                      || (onlyMyKeyIn('avail')
                          && (!(request.auth.uid in request.resource.data.avail)
                              || (request.resource.data.avail[request.auth.uid] is list
                                  && request.resource.data.avail[request.auth.uid].size() <= 1000))));

      allow delete: if crew() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
